RADIO_HOST=127.0.0.1
RADIO_PORT=8090
RADIO_DATA_DIR=/var/lib/radio-on-stick
RADIO_STATION_NAME=猫娘电台
RADIO_LOG_LEVEL=INFO

# Generate a long random token for each installation.
RADIO_ADMIN_TOKEN=replace-with-a-long-random-token
# Generate a different random salt for each installation.
RADIO_IP_SALT=replace-with-a-random-salt

# Optional tuning
# RADIO_UPSTREAM_TIMEOUT=8
# RADIO_UPSTREAM_RETRIES=2
# RADIO_REQUEST_PER_MIN=5
# RADIO_MESSAGE_PER_MIN=10
# RADIO_MESSAGE_DISPLAY=100
# RADIO_MESSAGE_KEEP=200
# RADIO_SEARCH_PER_MIN=20
# RADIO_LYRICS_PER_MIN=30
# RADIO_PIN_PER_MIN=10
# RADIO_ESTIMATED_ENDED_MIN=60
# Server-side head start after a skip so clients do not lose the intro.
# RADIO_TRACK_PREROLL_MS=3000
# RADIO_BG_INTERVAL=300
# RADIO_LISTENER_TTL=30
# Maximum uploaded local audio size in bytes (Nginx client_max_body_size must match).
# RADIO_UPLOAD_MAX_BYTES=67108864
# Temporary uploads are deleted as soon as playback ends (default).  The
# original upload file is only ever read; it is never modified.
# RADIO_UPLOAD_DELETE_AFTER_PLAY=1
# Legacy fallback grace for uploads when delete-after-play is disabled.
# RADIO_UPLOAD_OFFLINE_GRACE_SEC=60
# Hard retention for abandoned temporary uploads.
# RADIO_UPLOAD_RETENTION_SEC=86400
# How often the cleanup worker scans uploads.
# RADIO_UPLOAD_CLEANUP_INTERVAL=15
# Cap simultaneous HTTP fallback leaves (one per client IP). 0 disables them.
# RADIO_HTTP_LEAF_MAX=4
# HTTP leaf lease timeout in seconds.
# RADIO_HTTP_LEAF_TTL=20
# MP3 output bitrate used by the transcoder.
# RADIO_TRANSCODE_BITRATE=128
# Transcode MP3 input too (1) or pass MP3 through without re-encoding (0).
# RADIO_TRANSCODE_MP3=1
# ffmpeg executable path.
# RADIO_FFMPEG=ffmpeg
# Optional STUN for mesh WebRTC across the public internet.
# RADIO_MESH_STUN=stun:stun.l.google.com:19302
