RADIO_HOST=127.0.0.1
RADIO_PORT=8080
RADIO_DATA_DIR=/var/lib/radio-on-stick
RADIO_STATION_NAME=我的电台
RADIO_LOG_LEVEL=INFO

# Generate a long random token for each installation.
RADIO_ADMIN_TOKEN=replace-with-a-long-random-token
# Generate a different random salt for each installation.
RADIO_IP_SALT=replace-with-a-random-salt

# Optional tuning
# RADIO_UPSTREAM_TIMEOUT=8
# RADIO_UPSTREAM_RETRIES=2
# RADIO_REQUEST_PER_MIN=5
# RADIO_MESSAGE_PER_MIN=10
# RADIO_SEARCH_PER_MIN=20
# RADIO_LYRICS_PER_MIN=30
# RADIO_PIN_PER_MIN=10
# RADIO_ESTIMATED_ENDED_MIN=60
# RADIO_BG_INTERVAL=300
# RADIO_LISTENER_TTL=30
